{
  "name": "glamour-studio",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm media:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "test:booking": "node --conditions=react-server --test tests/booking/*.test.mjs",
    "test:booking-google": "node --conditions=react-server --test tests/booking/google-calendar-adapter.test.mjs",
    "booking:google:authorize": "node --env-file=.env.local scripts/booking/google-oauth-local.mjs",
    "media:optimize": "node scripts/media/lookbook-manifest.mjs",
    "media:check": "node scripts/media/lookbook-manifest.mjs --check"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@upstash/redis": "^1.38.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "0.0.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "sharp": "^0.35.3"
  }
}
