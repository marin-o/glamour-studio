# Localhost evaluation only. Never enable this in a production deployment.
BOOKING_LOCAL_TEST_MODE=1

# Use a dedicated secondary Google Calendar owned by the authorizing account.
GOOGLE_CALENDAR_ID=replace-with-dedicated-calendar-id

# Create a Google OAuth client whose application type is "Desktop app".
GOOGLE_OAUTH_CLIENT_ID=replace-with-desktop-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-desktop-client-secret

# Added to .env.local by `pnpm booking:google:authorize`.
# GOOGLE_OAUTH_REFRESH_TOKEN=
