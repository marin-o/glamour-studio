# Localhost evaluation only. Never enable this in a production deployment.
BOOKING_LOCAL_TEST_MODE=1

# Use a dedicated secondary Google Calendar owned by the authorizing account.
GOOGLE_CALENDAR_ID=replace-with-dedicated-calendar-id

# Create a Google OAuth client whose application type is "Desktop app".
GOOGLE_OAUTH_CLIENT_ID=replace-with-desktop-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-desktop-client-secret

# Added to .env.local by `pnpm booking:google:authorize`.
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Branded booking confirmation/status mail. Server-only; never use NEXT_PUBLIC_.
# RESEND_API_KEY=re_replace_with_server_secret

# Production on Netlify is fail-closed. Do not set this in .env.local; Netlify
# production must set BOOKING_DEPLOYMENT_PLATFORM=netlify (Vercel is a supported
# alternate and supplies VERCEL=1). An owner must explicitly set this to 1 only after all
# required production secrets, policy decisions, and external verification.
BOOKING_PRODUCTION_ENABLED=0
# BOOKING_DEPLOYMENT_PLATFORM=netlify

# Upstash REST credentials for one owner-controlled Redis database. Keep these
# server-only Vercel secrets; never use NEXT_PUBLIC_ names or commit real values.
# UPSTASH_REDIS_REST_URL=https://replace-with-upstash-rest-url
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# At least 16 non-whitespace characters. Used only to HMAC the trusted Vercel
# client address before rate-limit coordination; the raw address is not stored.
# BOOKING_REQUEST_HMAC_SECRET=replace-with-random-server-secret

# Every production policy value is required when BOOKING_PRODUCTION_ENABLED=1.
# These are example starting points, not approved business policy.
# BOOKING_LEAD_TIME_MINUTES=0
# BOOKING_HORIZON_DAYS=180
# BOOKING_IDEMPOTENCY_TTL_SECONDS=86400
# BOOKING_LOCK_TIMEOUT_MS=5000
# BOOKING_LOCK_LEASE_MS=60000
# BOOKING_PROVIDER_OPERATION_BUDGET_MS=45000
# BOOKING_LEASE_SAFETY_MS=5000
# BOOKING_RATE_LIMIT_AVAILABILITY_LIMIT=120
# BOOKING_RATE_LIMIT_AVAILABILITY_WINDOW_SECONDS=60
# BOOKING_RATE_LIMIT_BOOKING_LIMIT=20
# BOOKING_RATE_LIMIT_BOOKING_WINDOW_SECONDS=60
# BOOKING_RATE_LIMIT_MANAGEMENT_READ_LIMIT=60
# BOOKING_RATE_LIMIT_MANAGEMENT_READ_WINDOW_SECONDS=60
# BOOKING_RATE_LIMIT_MANAGEMENT_AVAILABILITY_LIMIT=60
# BOOKING_RATE_LIMIT_MANAGEMENT_AVAILABILITY_WINDOW_SECONDS=60
# BOOKING_RATE_LIMIT_MANAGEMENT_RESCHEDULE_LIMIT=12
# BOOKING_RATE_LIMIT_MANAGEMENT_RESCHEDULE_WINDOW_SECONDS=60
# BOOKING_RATE_LIMIT_MANAGEMENT_CANCEL_LIMIT=12
# BOOKING_RATE_LIMIT_MANAGEMENT_CANCEL_WINDOW_SECONDS=60
